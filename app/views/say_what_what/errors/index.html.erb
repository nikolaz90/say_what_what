<section class="sww-section rounded-t-none">
  <h2 class="sww-h2">Incoming errors</h2>

  <details>
    <summary class="mt-4 mb-4 flex flex-row space-between">
      <%= form_with url: errors_path, method: :get, class: 'mr-2', id: 'wider-search-form' do |f| %>
        <%= f.text_field :search,
          placeholder: 'Search /path or ActionController::UnknownFormat',
          value: params[:search],
          class: 'w-60' %>
      <% end %>
      or detailed search
    </summary>
    <%= form_with url: errors_path, method: :get, class: 'mb-4', id: 'detailed-search-form' do |f| %>
      <div>
        <%= f.label :error_class %>
        <%= f.text_field :error_class,
          placeholder: 'NoMethodError',
          value: params[:error_class] %>
      </div>
      <div>
      <%= f.label :message %>
      <%= f.text_field :message,
        placeholder: 'NoMethodError',
        value: params[:message] %>
      </div>
      <div>
        <%= f.label :severity %>
        <%= f.select :severity, [:error],
          value: params[:severity] %>
      </div>
      <div>
        <%= f.label :occurrence_count %>
        <%= f.number_field :occurrence_count,
          min: 1,
          value: params[:occurrence_count] %>
      </div>
      <div>
        <%= f.label :last_seen_at_from %>
        <%= f.datetime_local_field :last_seen_at_from,
          value: params[:last_seen_at_from] %>
      </div>

      <div class='mt-2 flex flex-row'>
        <%= f.submit 'Search', class: 'cta-1 bg-green mr-2' %>
        <%= link_to "Reset", errors_path, class: 'cta-1 bg-yellow' %>
      </div>
    <% end %>
    <%= button_to "Mark #{@pagy.count} errors shown as resolved", mark_all_resolution_path, { id: 'resolve-search-results-btn' } %>
  </details>

  <div>
    <p><%= @pagy.count %> errors</p>
  </div>

  <% @errors.each do |error| %>
    <%= link_to error_path(error), class: 'sww-a' do %>
      <%= render partial: 'error_article', locals: { error: } %>
    <% end %>
  <% end %>

  <%= @pagy.series_nav(:pagy, id: 'sww-pagination-nav').html_safe %>
</section>

<script>
  const widerSearchForm = document.getElementById('wider-search-form');
  const resolveSearchResultsBtn = document.getElementById('resolve-search-results-btn');

  document.querySelector('#wider-search-form > input[name="search"]').addEventListener('keyup', (e) => {
    if(e.target.value.length === 0) {
      resolveSearchResultsBtn.disabled = false;
    } else {
      resolveSearchResultsBtn.disabled = true;
    }
  });

  const csrfToken = document.getElementsByName('csrf-token')[0].content;
  resolveSearchResultsBtn.addEventListener('click', (e) => {
    e.preventDefault();

    const detailedSearchForm = document.getElementById('detailed-search-form');
    const searchFormData = new FormData(detailedSearchForm);
    searchFormData.append('form_loaded_at', Date.now())

    fetch("<%= mark_all_resolution_path %>", {
      headers: {
        'X-CSRF-Token': csrfToken
      },
      method: "POST",
      body: searchFormData
    }).then(response => response.json()).then(data => {
      window.location.href = data.location;
    });
  });
</script>
