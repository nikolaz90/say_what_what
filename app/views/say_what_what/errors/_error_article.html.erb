<article class="sww-article-one">
  <p class="sww-p truncate w-152">
    <strong>
      <%= error.error_class %>
    </strong>
    <% if error.resolved_at.present? %>
      <small>
        Resolved: <%= error.resolved_at %>
      </small>
    <% end %>
    <br>
    <small>
      <%= error.message %>
    </small>
  </p>
  <span class="sww-span text-xs">
    Occurrence:
    <%= error.occurrence_count %>
    Last seen at:
    <%= error.last_seen_at %>
  </span>
</article>
